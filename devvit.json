{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "carom-daily",
  "post": {
    "entrypoints": {
      "default": {
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {},
  "menu": {
    "items": [
      {
        "label": "Post today's CAROM",
        "description": "Create a post for today's daily table.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/on/menu/new-post"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/on/app/install"
  },
  "scheduler": {
    "tasks": {
      "daily-post": {
        "endpoint": "/internal/scheduler/daily-post",
        "cron": "5 0 * * *"
      }
    }
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true
    }
  },
  "scripts": {
    "dev": "npm run watch"
  },
  "dev": {
    "subreddit": "carom_daily_dev"
  }
}
